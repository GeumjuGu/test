---
import type { CollectionEntry } from 'astro:content';
interface Props { entry: CollectionEntry<'cases'>; position: number }
const { entry, position } = Astro.props;
const c = entry.data;
---

<article
  class="group relative flex flex-col rounded-2xl border border-line bg-surface p-5 transition-shadow hover:shadow-lg sm:p-6"
  data-reveal
  data-industry={c.industry}
>
  <div class="flex flex-wrap gap-1.5">
    <span class="tag">{c.client.split(' (')[0]}</span>
    {c.channels.map((ch) => <span class="tag">{ch}</span>)}
  </div>
  <h3 class="mt-4 text-xl font-bold tracking-tight">{c.title}</h3>
  <dl class="mt-4 space-y-2 text-[15px] leading-6">
    <div class="flex gap-3"><dt class="w-14 shrink-0 font-semibold text-ink-3">Problem</dt><dd class="text-ink-2">{c.problem}</dd></div>
    <div class="flex gap-3"><dt class="w-14 shrink-0 font-semibold text-ink-3">Action</dt><dd class="text-ink-2">{c.action}</dd></div>
  </dl>
  <div class="mt-5 rounded-xl bg-accent-soft p-4">
    <p class="text-xs font-semibold text-ink-3">Result · {c.period.replace(/.*\(|\)/g, '')}</p>
    <p class="mt-1 text-2xl font-extrabold tracking-tight text-accent">{c.result}</p>
  </div>
  <a
    href={`/work/${entry.id}/`}
    class="mt-5 text-sm font-semibold text-ink after:absolute after:inset-0 after:content-['']"
    data-track="case_open"
    data-case={entry.id}
    data-location={`card_${position}`}
  >자세히 보기 <span class="inline-block transition-transform group-hover:translate-x-1">→</span></a>
</article>
