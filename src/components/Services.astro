---
import services from '../data/services.json';
import profile from '../data/profile.json';
---

<section id="services" class="container-page scroll-mt-20 py-16 sm:py-20" data-section="services">
  <p class="eyebrow">What I Offer</p>
  <h2 class="section-title">이렇게 함께할 수 있습니다</h2>
  <div class="mt-8 grid gap-4 sm:grid-cols-3">
    {services.map((s) => (
      <article
        class:list={[
          'relative flex flex-col rounded-2xl border p-6',
          s.highlight ? 'border-accent bg-surface shadow-[0_0_0_1px_var(--accent)]' : 'border-line bg-surface',
        ]}
        data-reveal
      >
        {s.highlight && <span class="absolute -top-3 left-6 rounded-full bg-accent px-2.5 py-0.5 text-xs font-semibold text-accent-ink">가장 많이 선택</span>}
        <h3 class="text-lg font-bold">{s.name}</h3>
        <p class="mt-2 text-[15px] leading-6 text-ink-2">{s.summary}</p>
        <ul class="mt-5 flex-1 space-y-2 text-sm text-ink-2">
          {s.includes.map((i) => <li class="flex gap-2"><span class="text-accent" aria-hidden="true">✓</span>{i}</li>)}
        </ul>
        <div class="mt-6 border-t border-line pt-4 text-sm">
          <p class="text-ink-3">기간 · {s.duration}</p>
          {profile.showPricing && <p class="mt-1 text-lg font-bold">{s.price}</p>}
        </div>
      </article>
    ))}
  </div>
</section>
